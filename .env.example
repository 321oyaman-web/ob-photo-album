# ========================================
# 環境変数テンプレート（ダミー値のみ。実キーは絶対に書かない）
#
# 本番   : Vercel 管理画面の Environment Variables に設定する
# ローカル: OneDrive の外に .env を置く
#           例) C:\Users\qqdx4\secrets\ob-photo-album\.env
# ========================================

# --- Cloudflare R2 ---
# Cloudflare ダッシュボード > R2 > Overview 右側に表示されるアカウントID
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# R2 > API > Manage API Tokens で発行（Object Read & Write 権限）
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 作成したバケット名
R2_BUCKET=ob-photo-album

# --- 合言葉 ---
# 閲覧用（OB会メンバーに配布する）
ALBUM_PASSWORD=change-me-viewer

# 管理用（幹事だけが知る。写真の追加・削除ができる）
ADMIN_PASSWORD=change-me-admin

# --- セッション署名鍵 ---
# 32文字以上のランダムな文字列。下記コマンドで生成できる
#   PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
